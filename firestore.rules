rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Список гостей открыт на чтение и запись без входа в аккаунт —
    // так задумано: ссылкой пользуются несколько человек без регистрации.
    match /guests/{doc} { allow read, write: if true; }
    match /meta/{doc}   { allow read, write: if true; }
  }
}
